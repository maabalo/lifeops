# LifeOps settings (copy to .env and fill in; .env is never committed).
LIFEOPS_DATA_DIR=./data
LIFEOPS_COOKIE_SECURE=0            # 1 once served over HTTPS
LIFEOPS_SESSION_DAYS=14
LIFEOPS_TIMEZONE=Asia/Manila
LIFEOPS_SCHEDULER_SECONDS=60       # how often reminders are checked; 0 = off
# Push reminders (M4): leave empty on this Mac (a key is made in data/); set when online.
LIFEOPS_VAPID_PRIVATE_KEY=
LIFEOPS_VAPID_SUBJECT=
# Claude reads documents (M5): only when set AND chosen in Settings. Never commit a real key.
ANTHROPIC_API_KEY=
# A local model reads documents (Ollama on this computer: free, nothing leaves the Mac). Only 127.0.0.1/localhost.
LIFEOPS_OLLAMA_URL=http://127.0.0.1:11434
# Which Ollama model (blank = the first one Ollama has). Photos need a vision model, e.g. gemma3:12b.
LIFEOPS_OLLAMA_MODEL=
